# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME="German Waste Processor"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# ============================================
# DATABASE (PostgreSQL - Neon)
# ============================================
# Neon connection string — REPLACE WITH YOUR ACTUAL VALUE
# Format: postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
# JWT Secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET= 
JWT_ALGORITHM=

# Access Token (short-lived)
ACCESS_TOKEN_EXPIRE_MINUTES=

# Refresh Token (long-lived)
REFRESH_TOKEN_EXPIRE_DAYS=

# ============================================
# INITIAL ADMIN ACCOUNT (created on first startup)
# ============================================
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ============================================
# EMAIL SERVICE (Resend)
# ============================================
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY= 
EMAIL_FROM= 
EMAIL_FROM_NAME=

# ============================================
# ADDRESS VALIDATION (Nominatim OSM)
# ============================================
NOMINATIM_BASE_URL=
NOMINATIM_USER_AGENT=
NOMINATIM_TIMEOUT_SECONDS=5

# ============================================
# AI FALLBACK (HuggingFace)
# ============================================
# Get token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=

# ============================================
# PROXY POOL (Layer 2)
# ============================================
# Scylla runs automatically — no URL needed.
# If using a paid proxy service, add URL here.
PROXY_POOL_ENABLED= 
PROXY_POOL_URL=""

# ============================================
# SCRAPING SETTINGS
# ============================================
PLAYWRIGHT_HEADLESS=
PLAYWRIGHT_TIMEOUT_MS=
SCRAPING_TIMEOUT_SECONDS=
SCRAPING_MAX_RETRIES=

# ============================================
# CACHE SETTINGS
# ============================================
CACHE_TTL_DAYS=
# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_PUBLIC_PER_MINUTE=
RATE_LIMIT_ADMIN_PER_MINUTE=
RATE_LIMIT_TEST_CONNECTION_PER_MINUTE=

# ============================================
# CORS (Frontend URLs)
# ============================================
# Local development + production Vercel URL
CORS_ORIGINS=

# ============================================
# TIMEZONE
# ============================================
TIMEZONE=

# ============================================
# SERVER
# ============================================
HOST=
PORT=